# ==========================================
# Prescripto MERN System Configuration Template
# Copy this file to a new file named '.env' before running Docker Compose
# ==========================================

# --- Backend Configuration ---
PORT=4000
# Connection string for your external MongoDB Atlas database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prescripto?retryWrites=true&w=majority
# Secret token for JWT auth signing
JWT_SECRET=your_jwt_secret_key_here
# System currency code (defaults to USD if left blank)
CURRENCY=USD

# --- Cloudinary Configuration ---
# Required for uploading profile images
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret_key

# --- Admin Panel Login Credentials ---
ADMIN_EMAIL=admin@prescripto.com
ADMIN_PASSWORD=admin_secure_password_here

# --- Frontend Build-time Configurations ---
# URL pointing to the backend API server. If deploying locally, use http://localhost:4000.
# If deploying to AWS EC2 or production, replace with your EC2 public IP or domain name (e.g. http://18.xxx.xxx.xxx:4000).
VITE_BACKEND_URL=http://localhost:4000

# URL pointing to the admin panel dashboard.
# If deploying locally, use http://localhost:5174.
# If deploying to AWS EC2 or production, replace with your EC2 public IP or domain name (e.g. http://18.xxx.xxx.xxx:5174).
VITE_ADMIN_PANEL_URL=http://localhost:5174
